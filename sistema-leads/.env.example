# Conexão com o Postgres (Neon em produção, Postgres local em desenvolvimento).
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"
# Na Vercel, a integração Neon cria DATABASE_URL e DATABASE_URL_UNPOOLED automaticamente; a migração e o seed usam a DATABASE_URL_UNPOOLED (sem pooler) quando ela existe.

# Segredo usado pelo Better Auth para assinar sessões (gere com: openssl rand -base64 32).
BETTER_AUTH_SECRET=""

# URL pública do sistema, usada pelo Better Auth (ex.: http://localhost:3000).
BETTER_AUTH_URL="http://localhost:3000"

# Primeiro usuário gestao (npm run db:criar-gestao, também roda no build de produção).
# Defina na Vercel só para o primeiro deploy; depois de criado o usuário, pode remover.
# PRIMEIRO_GESTAO_EMAIL=""
# PRIMEIRO_GESTAO_NOME=""
# PRIMEIRO_GESTAO_SENHA=""

# Webhooks (roteiro em docs/WEBHOOKS.md). Sem estas variáveis, as rotas respondem 503.
# App Secret do app da Meta (Configurações > Básico), para validar o header X-Hub-Signature-256.
META_APP_SECRET=""

# Token combinado com a Meta para a verificação GET do webhook (hub.verify_token).
# Segredo interno: gere com openssl rand -hex 24 e cole o mesmo valor no painel da Meta.
META_VERIFY_TOKEN=""

# Token de acesso de longa duração da página (leads_retrieval, pages_manage_ads), para buscar os leads na Graph API.
META_PAGE_ACCESS_TOKEN=""

# Segredo enviado pelo Framer na query string (?k=) do webhook das LPs (gere com openssl rand -hex 24).
FRAMER_WEBHOOK_SECRET=""

# Segredo do reprocessamento (header Authorization: Bearer, usado pelo n8n e pelo cron da Vercel).
CRON_SECRET=""

# Fase 2: token (hottok) para validar o webhook da Hotmart.
# HOTMART_HOTTOK=""
