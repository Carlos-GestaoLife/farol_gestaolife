# Conexão com o Postgres (Neon em produção, Postgres local em desenvolvimento).
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo usado pelo Better Auth para assinar sessões (gere com: openssl rand -base64 32).
BETTER_AUTH_SECRET=""

# URL pública do sistema, usada pelo Better Auth (ex.: http://localhost:3000).
BETTER_AUTH_URL="http://localhost:3000"

# App Secret do app da Meta, para validar o header X-Hub-Signature-256 do webhook.
META_APP_SECRET=""

# Token combinado com a Meta para a verificação GET do webhook (hub.verify_token).
META_VERIFY_TOKEN=""

# Token de acesso da página, para buscar os leads na Graph API.
META_PAGE_ACCESS_TOKEN=""

# Segredo enviado pelo Framer na query string (?k=) do webhook das LPs.
FRAMER_WEBHOOK_SECRET=""

# Segredo do reprocessamento (header Authorization: Bearer, usado pelo n8n e pelo cron da Vercel).
CRON_SECRET=""

# Fase 2: token (hottok) para validar o webhook da Hotmart.
# HOTMART_HOTTOK=""
